rules_version = '2';

service cloud.firestore {

    match /databases/{database}/documents {

        match /rooms/{roomId} {

            allow read, create:
                if request.auth != null;


            allow update:
                if request.auth != null
                &&
                (
                    resource.data.hostUid
                        == request.auth.uid

                    ||

                    resource.data.guestUid
                        == request.auth.uid
                );


            allow delete:
                if request.auth != null
                &&
                resource.data.hostUid
                    == request.auth.uid;


            match /moves/{moveId} {

                allow read, create:
                    if request.auth != null;

                allow update, delete:
                    if false;

            }

        }

    }

}